        elem.Visible = false
        elem:Remove()
    end
    self.Elements = {}
    self.Main.Visible = false
    self.Border.Visible = false
    self.LastScan = ""
end

function InventoryViewer:Update(Title, Items)
    if not _G.ScannerEnabled then 
        self:Clear()
        return 
    end

    local currentCheck = Title or ""
    for k, v in pairs(Items) do currentCheck = currentCheck .. k .. v end
    
    -- Check for scale changes too
    local scaleStr = tostring(_G.UIScale)
    if self.LastScan == currentCheck .. scaleStr then
        self.Main.Position = self.Position
        self.Border.Position = self.Position
        return 
    end
    
    for _, elem in pairs(self.Elements) do elem:Remove() end
    self.Elements = {}

    if not Title then 
        self:Clear()
        return 
    end

    self.LastScan = currentCheck .. scaleStr

    -- [[ DYNAMIC SCALED DIMENSIONS ]] --
    local Scale = _G.UIScale or 1
