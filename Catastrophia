-- [[ HELPER: QUADRATIC INTERCEPT ]]
local function solveInterception(origin, projectileSpeed, targetPos, targetVelocity)
    local d = targetPos - origin
    local v = targetVelocity
    local a = v:Dot(v) - (projectileSpeed * projectileSpeed)
    local b = 2 * d:Dot(v)
    local c = d:Dot(d)

    if math.abs(a) < 0.001 then
        local t = -c / b
        return (t > 0) and (targetPos + (targetVelocity * t)) or targetPos, t
    end

    local delta = (b * b) - (4 * a * c)
    if delta < 0 then return nil, nil end 
    local sqrtDelta = math.sqrt(delta)
    local t1 = (-b - sqrtDelta) / (2 * a)
    local t2 = (-b + sqrtDelta) / (2 * a)
    local t = (t1 > 0 and t2 > 0) and math.min(t1, t2) or (t1 > 0 and t1) or (t2 > 0 and t2) or nil
    return t and (targetPos + (targetVelocity * t)) or nil, t
end

-- [[ ENHANCED PREDICTION SYSTEM ]]
local function AutoPrediction(targetRoot, tool)
    -- [[ 1. SETUP & SAFETY ]]
    local Players = game:GetService("Players")
    local Workspace = game:GetService("Workspace")
    local Stats = game:GetService("Stats")
    local lp = Players.LocalPlayer

    if not lp or not lp.Character then return Vector3.zero end
    local myChar = lp.Character
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    
    if not targetRoot or not targetRoot.Parent then return Vector3.zero end
    local hum = targetRoot.Parent:FindFirstChild("Humanoid")
    if not (myRoot and hum) then return Vector3.zero end

    -- [[ 2. DATA CALCULATION ]]
    local Settings = getgenv().Settings -- Access global settings safely
    local vel = targetRoot.AssemblyLinearVelocity
    local velsupress = Vector3.new(vel.X, 0, vel.Z)
    local gravity = Vector3.new(0, math.abs(Workspace.Gravity), 0)
    
    -- Safe Ping Calculation
    local rawPing = 0.05
    pcall(function()
        rawPing = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
    end)
    
    -- Safe Ping Lead
    local pingWeight = Settings.PingCustomWeight or 1 -- Fallback to 1 if nil
    local pingLead = Settings.PingCompensation and (vel * (rawPing * pingWeight)) or Vector3.zero

    -- Manual Y Setup (Calculated internally to avoid 'nil' errors)
    local manualYOffset = Settings.ManualYOffset or 0
    local manualYVector = Vector3.new(0, manualYOffset, 0)

    -- Factors
    local walkSpeed = hum.WalkSpeed or 16
    local ARFactor = math.max(math.abs(-0.11 * walkSpeed + 4.71), 1.5)
    local revFactor = math.max(math.abs(-0.11 * walkSpeed + 1), 1.5)
    local sgFactor = math.max(math.abs(-0.11 * walkSpeed * rawPing), 1.5)

    -- [[ 3. GUN LOGIC ]]
    -- We add manualYVector (Vector3) to the lead (Vector3). 
    if tool.Name == "AssaultRifle" then
        local lead = (velsupress / ARFactor) + Vector3.new(pingLead.X, 0, pingLead.Z)
        return lead + manualYVector
    elseif tool.Name == "Revolver" then
        local lead = (velsupress / revFactor) + Vector3.new(pingLead.X, 0, pingLead.Z)
        return lead + manualYVector
    elseif tool.Name == "Shotgun" then
        local lead = (velsupress / sgFactor) + Vector3.new(pingLead.X, 0, pingLead.Z)
        return lead + manualYVector
    elseif tool.Name == "Rock" then
        -- Rock physics logic
        return (vel * (rawPing / 2)) + (gravity * ((rawPing / 2)^2 / 2)) + manualYVector
    end

    -- [[ 4. BOW & CROSSBOW LOGIC ]]
    if tool.Name == "Bow" or tool.Name == "Crossbow" then
        local xzLead = Vector3.zero
        local distanceForY = 0
        local projSpeed = (tool.Name == "Bow") and Settings.BowSpeed or Settings.CrossbowSpeed

        if Settings.BowPredictionType == "Quadratic" and solveInterception then
            local interceptPos, t = solveInterception(myRoot.Position, projSpeed, targetRoot.Position, vel)
            interceptPos = interceptPos or (targetRoot.Position + pingLead)
            xzLead = (interceptPos - targetRoot.Position) + pingLead
            distanceForY = (interceptPos - myRoot.Position).Magnitude
        else
            xzLead = (vel / 2) * Settings.SimpleXScaler + pingLead
            distanceForY = (targetRoot.Position - myRoot.Position).Magnitude
        end

        -- Y Logic (Golden Numbers)
        local yOffset = 0
        local d = distanceForY
        if tool.Name == "Bow" then
            yOffset = (0.00122 * (d^2)) + (0.0179 * d) - 0.418
        elseif tool.Name == "Crossbow" then
            yOffset = (0.00041 * (d^2)) + (0.006 * d) - 0.1
        end

        return Vector3.new(
            xzLead.X, 
            (yOffset * Settings.GlobalYScaler) + manualYOffset, 
            xzLead.Z
        )
    end

    return Vector3.zero
end
-- This replaces both GetClosestToMouse and GetClosestTarget
local function GetAimbotTarget()
    local MouseLocation = UserInputService:GetMouseLocation()
    local ClosestTarget = nil
    -- Always respect the FOV Circle radius as the screen-space boundary
    local MaxScreenDist = _G.CircleRadius or 50 
    
    local function ValidateTarget(Ent)
        if not Ent or not Ent:FindFirstChild("HumanoidRootPart") then return end
        local Hum = Ent:FindFirstChildOfClass("Humanoid")
        if not Hum or Hum.Health <= 0 then return end

        -- 1. Check World Distance (Max Distance Slider)
        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end
        
        local worldDist = (Ent.HumanoidRootPart.Position - myRoot.Position).Magnitude
        if worldDist > getgenv().Settings.MaxDistance then return end

        -- 2. Check Screen Distance (FOV Circle)
        local ScreenPos, OnScreen = Camera:WorldToViewportPoint(Ent.HumanoidRootPart.Position)
        if OnScreen then
            local ScreenDist = (Vector2.new(ScreenPos.X, ScreenPos.Y) - MouseLocation).Magnitude
            if ScreenDist < MaxScreenDist then
                MaxScreenDist = ScreenDist
                ClosestTarget = Ent
            end
        end
    end

    -- Loop Players
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            ValidateTarget(p.Character)
        end
    end

    -- Loop Soldiers (If enabled in UI)
    if getgenv().Settings.SoldierAimbot then
        local SoldierFolder = workspace.Soldiers:FindFirstChild("Soldiers")
        if SoldierFolder then
            for _, s in pairs(SoldierFolder:GetChildren()) do
                -- Only check if it's a model (NPC)
                if s:IsA("Model") then
                    ValidateTarget(s)
                end
            end
        end
    end

    return ClosestTarget
end

-- [[ CONSOLIDATED MAIN LOOP ]]
RunService.RenderStepped:Connect(function()
    -- 1. Sync FOV Circle
    if FOVCircle then
        FOVCircle.Visible = _G.CircleVisible or false
        FOVCircle.Radius = _G.CircleRadius or 50
        FOVCircle.Position = UserInputService:GetMouseLocation()
    end

    -- 2. Master Safety Check
    if not getgenv().Settings.aimbot or not LocalPlayer.Character then 
        if TargetTracer then TargetTracer.Visible = false end
        return 
    end

    -- 3. Aimbot Trigger (Right Click)
    if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        local currentTool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
        
        if currentTool and weaponNames[currentTool.Name] then
            -- Target Acquisition (Checks Players and Soldiers)
            if not LockedTarget or not LockedTarget.Parent or not LockedTarget:FindFirstChildOfClass("Humanoid") or LockedTarget:FindFirstChildOfClass("Humanoid").Health <= 0 then
                LockedTarget = GetAimbotTarget()
            end

            if LockedTarget then
                local targetRoot = LockedTarget:FindFirstChild("HumanoidRootPart")
                local myRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                
                if targetRoot and myRoot then
                    -- Check Max Distance
                    local dist = (targetRoot.Position - myRoot.Position).Magnitude
                    if dist > getgenv().Settings.MaxDistance then
                        LockedTarget = nil
                        if TargetTracer then TargetTracer.Visible = false end
                        return 
                    end

                    -- [[ VISUALS: TRACER LINE ]]
                    -- This draws to the ACTUAL targetRoot, NOT the prediction
                    if TargetTracer and getgenv().Settings.ShowTracer then
                        local ScreenPos, OnScreen = Camera:WorldToViewportPoint(targetRoot.Position)
                        
                        if OnScreen then
                            TargetTracer.Visible = true
                            TargetTracer.From = UserInputService:GetMouseLocation()
                            TargetTracer.To = Vector2.new(ScreenPos.X, ScreenPos.Y)
                            TargetTracer.Color = getgenv().Settings.TracerColor or Color3.new(1,1,1)
                        else
                            TargetTracer.Visible = false
                        end
                    elseif TargetTracer then
                        TargetTracer.Visible = false
                    end

                    -- [[ MECHANICS: CAMERA LOCK ]]
                    -- Camera still uses prediction for hitting moving targets
                    local predictionOffset = AutoPrediction(targetRoot, currentTool)
                    local finalTargetPos = targetRoot.Position + predictionOffset
                    local targetCFrame = CFrame.lookAt(Camera.CFrame.Position, finalTargetPos)
                    
                    if getgenv().Settings.SmoothingEnabled then
                        local intensity = getgenv().Settings.SmoothIntensity
                        Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, intensity)
                    else
                        Camera.CFrame = targetCFrame
                    end
                end
            else
                if TargetTracer then TargetTracer.Visible = false end
            end
        else
            if TargetTracer then TargetTracer.Visible = false end
        end
    else
        -- Cleanup when Right Click is released
        LockedTarget = nil
        if TargetTracer then TargetTracer.Visible = false end
    end
end)

-- Animal and Ore Esp

local DrawingPool = {}
local function GetDrawing(index)
    if not DrawingPool[index] then
        local t = Drawing.new("Text")
        t.Visible = false
        t.Center = true
        t.Outline = true
        t.Font = 2
        DrawingPool[index] = t
    end
    return DrawingPool[index]
end

local function GetAnimalName(model)
    local mesh = model:FindFirstChild("AnimalMesh", true)
    if mesh and (mesh:IsA("MeshPart") or mesh:IsA("SpecialMesh")) then
        local id = tostring(mesh.MeshId)
        for name, data in pairs(AnimalList) do
            if id:find(data.Id) then return name end
        end
    end
    return nil
end

RunService.RenderStepped:Connect(function()
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local drawIndex = 1

    if root then
        -- Handle Ores
        if OreConfig.Ores.Enabled then
            local suv = Workspace:FindFirstChild("Suroviny")
            if suv then
                for _, item in pairs(suv:GetChildren()) do
                    local oreData = OreList[item.Name]
                    if oreData and oreData.Enabled then
                        local dist = (root.Position - item.Position).Magnitude
                        if dist < OreConfig.Ores.Distance then
                            local screenPos, onScreen = Camera:WorldToViewportPoint(item.Position)
                            if onScreen then
                                local d = GetDrawing(drawIndex)
                                d.Visible = true
                                d.Position = Vector2.new(screenPos.X, screenPos.Y)
                                d.Text = string.format("%s\n[%dm]", item.Name, math.floor(dist))
                                d.Color = oreData.Color
                                d.Size = OreConfig.Ores.TextSize
                                drawIndex = drawIndex + 1
                            end
                        end
                    end
                end
            end
        end

        -- Handle Animals
        if OreConfig.Animals.Enabled then
            local aniFolder = Workspace:FindFirstChild("Animals")
            if aniFolder then
                for _, animal in pairs(aniFolder:GetChildren()) do
                    local name = GetAnimalName(animal)
                    local aRoot = animal:FindFirstChild("HumanoidRootPart") or animal.PrimaryPart
                    if name and aRoot then
                        local dist = (root.Position - aRoot.Position).Magnitude
                        if dist < OreConfig.Animals.Distance then
                            local screenPos, onScreen = Camera:WorldToViewportPoint(aRoot.Position)
                            if onScreen then
                                local d = GetDrawing(drawIndex)
                                d.Visible = true
                                d.Position = Vector2.new(screenPos.X, screenPos.Y)
                                d.Text = string.format("%s\n[%dm]", name, math.floor(dist))
                                d.Color = AnimalList[name].Color
                                d.Size = OreConfig.Animals.TextSize
                                drawIndex = drawIndex + 1
                            end
                        end
                    end
                end
            end
        end
    end

    -- Hide any unused drawings in the pool to prevent ghosting/flicker
    for i = drawIndex, #DrawingPool do
        DrawingPool[i].Visible = false
    end
end)

