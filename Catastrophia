    local LineHeight      = 22 * Scale
    local HeaderPadding   = 35 * Scale
    local TitleSize       = 18 * Scale
    local ItemFontSize    = 16 * Scale
    local StatusFontSize  = 14 * Scale 

    local Count = 0
    for _ in pairs(Items) do Count = Count + 1 end
    
    local TotalHeight = (Count * LineHeight) + HeaderPadding + 15
    local Size = Vector2.new(BoxWidth, TotalHeight)
    
    self.Main.Size = Size
    self.Main.Position = self.Position
    self.Main.Visible = true
    
    self.Border.Size = Size
    self.Border.Position = self.Position
    self.Border.Visible = true

    local TitleText = Drawing.new("Text")
    TitleText.Text = Title
    TitleText.Size = TitleSize
    TitleText.Center = true
    TitleText.Outline = true
    TitleText.Color = Color3.fromRGB(0, 255, 0) 
    TitleText.Position = self.Position + Vector2.new(BoxWidth/2, 12 * Scale)
    TitleText.Visible = true
    table.insert(self.Elements, TitleText)

    local YOffset = HeaderPadding
    for Name, Status in pairs(Items) do
        local ItemColor = (Status == "[EQUIPPED]") and Color3.fromRGB(255, 200, 0) or Color3.fromRGB(255, 255, 255)
        
