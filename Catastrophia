task.spawn(function()
    while task.wait(0.5) do
        if PCHAMS then
            local soldiers = Workspace:FindFirstChild("Soldiers")
            if soldiers then
                for _, obj in pairs(soldiers:GetDescendants()) do
                    if obj:IsA("Model") and obj.Name ~= player.Name then
                        for _, part in pairs(obj:GetChildren()) do
                            if part:IsA("BasePart") or part:IsA("MeshPart") then
                                local existingChams = {}
                                for _, child in pairs(part:GetChildren()) do
                                    if child.Name == "cham" then table.insert(existingChams, child) end
                                end

                                if #existingChams == 0 then
                                    for _, face in pairs(faces) do
                                        PLAYERSURFACE(part, face, SChamColor, SChamTransparency) -- Pass Soldier Colors
                                    end
                                else
                                    for _, gui in pairs(existingChams) do
                                        local frame = gui:FindFirstChild("VisualFrame")
                                        if frame then
                                            frame.BackgroundColor3 = SChamColor
                                            frame.BackgroundTransparency = SChamTransparency
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

