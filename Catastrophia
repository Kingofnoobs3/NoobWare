local function getTargetParent()
    return player:FindFirstChild("PlayerGui") -- Fixed: changed localPlayer to player
end

local function createESP(target, char)
    local targetParent = getTargetParent()
    if not targetParent then return end
    
    local oldESP = targetParent:FindFirstChild(target.Name .. "_HealthESP")
    if oldESP then oldESP:Destroy() end
    
