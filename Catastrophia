    if typeof(v) == "function" and islclosure(v) then 
        local info = getfenv(v)
        if info.script and info.script.Name == anti_name then 
            local constants = getconstants(v)
            if constants[12] and constants[11] then 
                if constants[11] == "Backpack" and constants[12] == "FireServer" then 
                    hookfunction(v, function() return end)
                end 
            end 
        end 
    end 
end

